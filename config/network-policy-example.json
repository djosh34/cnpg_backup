{
  "apiVersion": "v1", "kind": "List", "items": [
    {
      "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy",
      "metadata": {"name": "cnpg-backup-manager", "namespace": "cnpg-system"},
      "spec": {
        "podSelector": {"matchLabels": {"app": "cnpg-backup"}},
        "policyTypes": ["Ingress", "Egress"],
        "ingress": [
          {"from": [{"podSelector": {"matchLabels": {"app.kubernetes.io/name": "cloudnative-pg"}}}], "ports": [{"protocol": "TCP", "port": 9090}]},
          {"from": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "monitoring"}}, "podSelector": {"matchLabels": {"app.kubernetes.io/name": "prometheus"}}}], "ports": [{"protocol": "TCP", "port": 9091}]}
        ],
        "egress": [
          {"to": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "kube-system"}}, "podSelector": {"matchLabels": {"k8s-app": "kube-dns"}}}], "ports": [{"protocol": "UDP", "port": 53}, {"protocol": "TCP", "port": 53}]},
          {"to": [{"ipBlock": {"cidr": "192.0.2.10/32"}}], "ports": [{"protocol": "TCP", "port": 6443}]},
          {"to": [{"ipBlock": {"cidr": "192.0.2.20/32"}}], "ports": [{"protocol": "TCP", "port": 443}]}
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy",
      "metadata": {"name": "cnpg-database-and-backup", "namespace": "database"},
      "spec": {
        "podSelector": {"matchLabels": {"cnpg.io/cluster": "database"}},
        "policyTypes": ["Ingress", "Egress"],
        "ingress": [
          {"from": [{"podSelector": {"matchLabels": {"cnpg.io/cluster": "database"}}}, {"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "application"}}}], "ports": [{"protocol": "TCP", "port": 5432}]},
          {"from": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "cnpg-system"}}, "podSelector": {"matchLabels": {"app.kubernetes.io/name": "cloudnative-pg"}}}], "ports": [{"protocol": "TCP", "port": 8000}]},
          {"from": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "monitoring"}}, "podSelector": {"matchLabels": {"app.kubernetes.io/name": "prometheus"}}}], "ports": [{"protocol": "TCP", "port": 9187}]}
        ],
        "egress": [
          {"to": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "kube-system"}}, "podSelector": {"matchLabels": {"k8s-app": "kube-dns"}}}], "ports": [{"protocol": "UDP", "port": 53}, {"protocol": "TCP", "port": 53}]},
          {"to": [{"ipBlock": {"cidr": "192.0.2.10/32"}}], "ports": [{"protocol": "TCP", "port": 6443}]},
          {"to": [{"ipBlock": {"cidr": "192.0.2.20/32"}}], "ports": [{"protocol": "TCP", "port": 443}]},
          {"to": [{"podSelector": {"matchLabels": {"cnpg.io/cluster": "database"}}}], "ports": [{"protocol": "TCP", "port": 5432}]}
        ]
      }
    }
  ]
}

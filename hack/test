#!/usr/bin/env bash
# One local/CI entry point. All state is user-owned and disk-backed in checkout.
set -euo pipefail
cd "$(dirname "$0")/.."
profile=${1:-fast}
shift || true
case "$profile" in harness|unit|fast|integration|guard|cnpg-smoke|race|fuzz-smoke|campaign-focused|recovery-campaign|campaign-bundle|campaign-plan|campaign-preflight|campaign-collect|campaign-clean|campaign-compare|campaign-aggregate) ;; *) echo 'usage: hack/test harness|unit|fast|integration|guard|cnpg-smoke|race|fuzz-smoke|campaign-focused|recovery-campaign|campaign-{bundle,plan,compare,aggregate} [options]' >&2; exit 2;; esac
mkdir -p .work/tmp artifacts/fast
# Keep an explicitly supplied short disk-backed runtime path. AF_UNIX names
# have a kernel length limit; worktree nesting is not a product failure.
export TMPDIR="${CNPG_TEST_TMP:-${TMPDIR:-$PWD/.work/tmp}}"
mkdir -p "$TMPDIR"
export GOTMPDIR="$TMPDIR"
# Exercise the same fixture/oracle tests before downloads, Go builds or Docker.
if [[ $profile = harness && $# -gt 0 ]]; then
  PYTHONPATH="$PWD/hack${PYTHONPATH:+:$PYTHONPATH}" python3 -m unittest "$@" 2>&1 | tee artifacts/fast/harness-unit.log
  exit 0
fi
python3 -m unittest discover -s hack -p 'test_*.py' 2>&1 | tee artifacts/fast/harness-unit.log
python3 hack/backup_metrics_smoke.py --self-test 2>&1 | tee artifacts/fast/metrics-harness-unit.log
python3 hack/repository_crd.py --check
[[ $profile != harness ]] || exit 0
# Exact-artifact campaigns run the fixtures, never the subject build/image pipeline.
case "$profile" in
  recovery-campaign) exec python3 hack/recovery_campaign.py run "$@" ;;
  campaign-*)
    if [[ $profile != campaign-focused ]]; then
      exec python3 hack/recovery_campaign.py "${profile#campaign-}" "$@"
    fi ;;
esac
export CNPG_BUILD_CACHE=${CNPG_BUILD_CACHE:-"$PWD/.work/tools"}
if [[ $profile = unit || $profile = race || $profile = fuzz-smoke || $profile = campaign-focused ]]; then
  python3 hack/bootstrap.py --go-only
else
  python3 hack/bootstrap.py
fi
export PATH="$CNPG_BUILD_CACHE/go/bin:$PATH" CGO_ENABLED=0 GOTOOLCHAIN=local
export GOOS=linux GOARCH=amd64 GOAMD64=v1 GOEXPERIMENT='' GOFLAGS='-p=2' GOMAXPROCS=2 GOWORK=off
export CNPG_PROMTOOL
CNPG_PROMTOOL=$(python3 hack/test_tools.py)
"$CNPG_PROMTOOL" --version > artifacts/fast/promtool-version.txt 2>&1
cp build/test-tools.lock.json artifacts/fast/
if [[ $profile = race ]]; then
  CGO_ENABLED=1 go test -race -count=1 -timeout=180s ./... 2>&1 | tee artifacts/fast/race.log
  exit 0
fi
if [[ $profile = fuzz-smoke ]]; then
  for target in FuzzNativeManifest FuzzNativeArchive; do
    go test -json ./internal/postgres -run '^$' -fuzz "^${target}$" -fuzztime=30s -parallel=2 -timeout=90s \
      | tee "artifacts/fast/${target}.jsonl"
  done
  exit 0
fi
if [[ $profile = campaign-focused ]]; then
  go test -count=100 -shuffle=1806 -timeout=1800s -run 'Test(TerminalPodEventChecksCompletionBeforeCleanup|CompletionConsumesEveryPodPage|CompletionRequiresAllOriginalRetryPodsAndContainers|OriginalReaderReleaseIsAfterTaskDrainBeforeAcknowledgment)' ./internal/cnpgi ./internal/recoveryguard \
    | tee artifacts/fast/campaign-focused-go.log
  go test -count=100 -shuffle=1806 -timeout=1800s ./hack/recoveryactor | tee artifacts/fast/campaign-focused-actor.log
  for iteration in $(seq 1 100); do
    PYTHONPATH=hack python3 -m unittest test_recovery_drain test_recovery_replacement test_campaign_process test_campaign_plan
  done 2>&1 | tee artifacts/fast/campaign-focused-python.log
  exit 0
fi
[[ -z $(gofmt -l cmd internal hack/*/*.go) ]] || { echo 'gofmt required' >&2; exit 1; }
go vet ./... 2>&1 | tee artifacts/fast/vet.log
go test -count=1 -timeout=120s ./... 2>&1 | tee artifacts/fast/unit.log
python3 -m unittest discover -s hack -p 'go_harness_test.py' 2>&1 | tee artifacts/fast/go-harness.log
[[ $profile != unit ]] || exit 0
python3 hack/build.py
python3 hack/checkbuild.py | tee artifacts/fast/image-root-check.log
python3 --version > artifacts/fast/build-host.txt
uname -a >> artifacts/fast/build-host.txt
if command -v dpkg-deb >/dev/null; then dpkg-deb --version >> artifacts/fast/build-host.txt; fi
cp build/inputs.lock.json artifacts/fast/
cp build/out/{go-linked.json,go-modules.json,go-version.txt,version.txt,manager-files.json,pg18-files.json,go-dependency-scopes.json,go-production-packages.json,go-tests-packages.json,go-executable-packages.json} artifacts/fast/
cp build/out/pg18/usr/share/cnpg-backup/{native-files.json,native-packages.json} artifacts/fast/
if [[ $profile = cnpg-smoke ]]; then
  python3 hack/images.py
  python3 hack/cnpg_smoke.py
fi
if [[ $profile = guard ]]; then
  python3 hack/guard.py
fi
if [[ $profile = integration ]]; then
  mkdir -p artifacts/s3
  CNPG_S3_ARTIFACT_DIR="$PWD/artifacts/s3" CNPG_S3_INTEGRATION=1 CNPG_S3_MINIO_BINARY="$CNPG_BUILD_CACHE/downloads/minio" \
    go test -json -count=1 -timeout=600s -run '^TestMinIO(Primitives|Repository|WAL)$' ./internal/s3store ./internal/repository ./internal/wal \
    | tee artifacts/s3/minio-integration.jsonl
  for arg in "$@"; do
    if [[ $arg = --images ]]; then
      python3 hack/images.py
      cp build/out/{images.json,manager-export.json,pg18-export.json,manager-inspect.json,pg18-inspect.json} artifacts/fast/
      break
    fi
  done
  python3 hack/recovery.py "$@"
fi
